{
  "name": "reusehub",
  "version": "1.0.0",
  "private": true,
  "description": "ReuseHub monorepo root -- runs the backend API and frontend dev server together",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue.bold,magenta.bold --handle-input \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",

    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",

    "db:setup": "npm run db:setup --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:reset": "npm run db:reset --prefix backend",

    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "test": "npm test --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
