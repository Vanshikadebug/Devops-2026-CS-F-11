# ---------------------------------------------------------------
# ReuseHub .gitignore
# Anything listed here is invisible to Git and can never be
# committed or pushed to GitHub, even by accident.
# ---------------------------------------------------------------

# Dependencies -- reinstallable from package.json, huge, never committed
node_modules/
.pnp
.pnp.js

# Secrets -- THE MOST IMPORTANT LINES IN THIS FILE.
# .env holds the DB password and JWT secret. It must stay local.
# .env.example is intentionally NOT ignored: it is the safe template.
.env
.env.local
.env.*.local
*.pem
*.key

# Build output -- regenerated by `npm run build`
dist/
dist-ssr/
build/

# Test output
coverage/
*.lcov
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Runtime / temp
tmp/
temp/
*.local

# Uploaded files (if we ever move off image URLs to real uploads)
uploads/
