// ReuseHub -- Prisma schema (single source of truth for the database).
//
// Storage is MongoDB. Integer ids are kept (stored as _id) so URLs, validators
// and the frontend are unchanged; lib/prisma.js hands them out from a
// `counters` collection. Indexes and uniques are applied with `prisma db push`.
//
// Scalar fields keep their snake_case names on purpose: the API returns
// snake_case keys (image_url, college_name, created_at) and the whole
// frontend reads them, so @@map keeps column, model and JSON key spelled
// one way. Enums that store a value with a space (e.g. "Like New") @map it,
// because a space is not a legal Prisma identifier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model City {
  id         Int      @id @map("_id")
  name       String
  state      String
  slug       String   @unique(map: "uq_cities_slug")
  created_at DateTime @default(now())
  areas      Area[]

  @@unique([name, state], map: "uq_cities_name_state")
  @@map("cities")
}

model Area {
  id         Int       @id @map("_id")
  city_id    Int
  name       String
  slug       String
  created_at DateTime  @default(now())
  city       City      @relation(fields: [city_id], references: [id], onDelete: Cascade)
  colleges   College[]

  @@unique([city_id, name], map: "uq_areas_city_name")
  @@unique([city_id, slug], map: "uq_areas_city_slug")
  @@index([city_id], map: "idx_areas_city")
  @@map("areas")
}

model College {
  id          Int      @id @map("_id")
  area_id     Int
  name        String
  short_name  String
  slug        String   @unique(map: "uq_colleges_slug")
  description String?
  image_url   String?
  created_at  DateTime @default(now())
  area        Area     @relation(fields: [area_id], references: [id], onDelete: Cascade)
  items       Item[]
  users       User[]

  @@index([area_id], map: "idx_colleges_area")
  @@map("colleges")
}

model User {
  id            Int        @id @map("_id")
  name          String
  email         String     @unique(map: "uq_users_email")
  mobile        String
  password      String
  college_id    Int?
  role          UserRole   @default(user)
  status        UserStatus @default(active)
  last_login_at DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @default(now()) @updatedAt

  college         College?          @relation(fields: [college_id], references: [id])
  items           Item[]            @relation("ItemOwner")
  moderatedItems  Item[]            @relation("ItemModerator")
  requests        Request[]
  reportsFiled    Report[]          @relation("ReportReporter")
  reportsAgainst  Report[]          @relation("ReportedUser")
  reportsReviewed Report[]          @relation("ReportReviewer")
  auditLogs       AuditLog[]
  updatedSettings PlatformSetting[]

  @@index([college_id], map: "idx_users_college")
  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

// category and item_condition are VARCHAR, not enums: categories and
// conditions are admin-editable rows (see Category / Condition). The column
// stores the label string so the API's { category: "Books" } shape is
// unchanged and no response mapper needs rewriting. Runtime validation
// checks the value against the active rows.
model Item {
  id                Int                  @id @map("_id")
  user_id           Int
  name              String
  description       String
  category          String
  item_condition    String
  location          String
  college_id        Int?
  image_url         String?
  status            ItemStatus           @default(Available)
  moderation_status ItemModerationStatus @default(Approved)
  moderated_by      Int?
  moderated_at      DateTime?
  moderation_reason String?
  created_at        DateTime             @default(now())
  updated_at        DateTime             @default(now()) @updatedAt

  owner     User      @relation("ItemOwner", fields: [user_id], references: [id], onDelete: Cascade)
  moderator User?     @relation("ItemModerator", fields: [moderated_by], references: [id])
  college   College?  @relation(fields: [college_id], references: [id])
  requests  Request[]
  reports   Report[]

  @@index([moderated_by])
  @@index([category], map: "idx_items_category")
  @@index([college_id, status, created_at], map: "idx_items_college_status_created")
  @@index([created_at], map: "idx_items_created")
  @@index([moderation_status], map: "idx_items_moderation")
  @@index([status], map: "idx_items_status")
  @@index([user_id], map: "idx_items_user")
  @@map("items")
}

model Request {
  id           Int           @id @map("_id")
  item_id      Int
  requester_id Int
  message      String?
  status       RequestStatus @default(Pending)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @default(now()) @updatedAt

  item      Item @relation(fields: [item_id], references: [id], onDelete: Cascade)
  requester User @relation(fields: [requester_id], references: [id], onDelete: Cascade)

  @@unique([item_id, requester_id], map: "uq_requests_item_requester")
  @@index([item_id], map: "idx_requests_item")
  @@index([requester_id], map: "idx_requests_requester")
  @@index([status], map: "idx_requests_status")
  @@map("requests")
}

model Report {
  id               Int          @id @map("_id")
  reporter_id      Int
  reported_item_id Int?
  reported_user_id Int?
  reason           ReportReason
  details          String?
  status           ReportStatus @default(Open)
  reviewed_by      Int?
  reviewed_at      DateTime?
  resolution_note  String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @default(now()) @updatedAt

  item         Item? @relation(fields: [reported_item_id], references: [id], onDelete: Cascade)
  reporter     User  @relation("ReportReporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUser", fields: [reported_user_id], references: [id], onDelete: Cascade)
  reviewer     User? @relation("ReportReviewer", fields: [reviewed_by], references: [id])

  @@unique([reported_item_id, reporter_id], map: "uq_reports_item_reporter")
  @@unique([reported_user_id, reporter_id], map: "uq_reports_user_reporter")
  @@index([reviewed_by])
  @@index([created_at], map: "idx_reports_created")
  @@index([reporter_id], map: "idx_reports_reporter")
  @@index([status], map: "idx_reports_status")
  @@map("reports")
}

model AuditLog {
  id          Int                @id @map("_id")
  admin_id    Int?
  admin_email String
  action      String
  target_type AuditLogTargetType
  target_id   Int?
  description String
  changes     Json?
  ip_address  String?
  created_at  DateTime           @default(now())

  admin User? @relation(fields: [admin_id], references: [id])

  @@index([action], map: "idx_audit_action")
  @@index([admin_id], map: "idx_audit_admin")
  @@index([created_at], map: "idx_audit_created")
  @@index([target_type, target_id], map: "idx_audit_target")
  @@map("audit_logs")
}

model PlatformSetting {
  setting_key   String                  @id @map("_id")
  setting_value String?
  value_type    PlatformSettingType     @default(string)
  label         String
  description   String?
  category      PlatformSettingCategory @default(general)
  is_editable   Boolean                 @default(true)
  updated_by    Int?
  updated_at    DateTime                @default(now()) @updatedAt

  updatedByUser User? @relation(fields: [updated_by], references: [id])

  @@index([updated_by])
  @@index([category], map: "idx_settings_category")
  @@map("platform_settings")
}

// Admin-editable taxonomy. items.category stores `label`; renaming a label
// here does not rewrite existing item rows, so the UI treats slug as the
// stable key and label as display text.
model Category {
  id         Int      @id @map("_id")
  slug       String   @unique(map: "uq_categories_slug")
  label      String
  // Default lives in application code, not DDL: an emoji in a SQL DEFAULT
  // round-trips badly across charsets and shows as permanent schema drift.
  glyph      String   @default("")
  tint       String   @default("other")
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([is_active, sort_order], map: "idx_categories_active_order")
  @@map("categories")
}

model Condition {
  id         Int      @id @map("_id")
  slug       String   @unique(map: "uq_conditions_slug")
  label      String
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([is_active, sort_order], map: "idx_conditions_active_order")
  @@map("conditions")
}

model NavLink {
  id         Int         @id @map("_id")
  label      String
  href       String
  placement  NavPlacement @default(header)
  sort_order Int         @default(0)
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now())
  updated_at DateTime    @default(now()) @updatedAt

  @@index([placement, is_active, sort_order], map: "idx_nav_placement_order")
  @@map("nav_links")
}

model SocialLink {
  id         Int      @id @map("_id")
  platform   String
  url        String
  icon       String   @default("link")
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([is_active, sort_order], map: "idx_social_active_order")
  @@map("social_links")
}

enum UserRole {
  user
  moderator
  admin
  super_admin
}

enum UserStatus {
  active
  blocked
}

enum ItemStatus {
  Available
  Reserved
  Unavailable
}

enum ItemModerationStatus {
  Pending
  Approved
  Rejected
  Hidden
}

enum RequestStatus {
  Pending
  Accepted
  Rejected
}

enum ReportReason {
  Spam
  Inappropriate
  Fraud
  Duplicate
  Wrong_Category @map("Wrong Category")
  Other
}

enum ReportStatus {
  Open
  Under_Review @map("Under Review")
  Resolved
  Rejected
}

enum AuditLogTargetType {
  user
  item
  college
  city
  area
  report
  setting
  category
  condition
  content
}

enum PlatformSettingType {
  string
  number
  boolean
  json
  color
}

enum PlatformSettingCategory {
  general
  branding
  theme
  content
  contact
  users
  items
  moderation
  seo
}

enum NavPlacement {
  header
  footer
}
