# ReuseHub API — environment template
#
#   cp .env.example .env      (inside backend/)
#
# Only needed for running the API directly with `npm run dev`. Under Docker
# Compose the values come from the repo-root .env instead, and the container
# receives them from docker-compose.yml.

# --- Server ---------------------------------------------------------
# 5000, not 8080: Jenkins occupies 8080 on the development machine.
PORT=5000
NODE_ENV=development

# Browser origins allowed to call this API, comma-separated. Add a teammate's
# dev server here when they point VITE_API_URL at you.
#   CORS_ORIGINS=http://localhost:5173,http://192.168.1.20:5173
CORS_ORIGINS=http://localhost:5173

# Also trust the throwaway hostnames tunnels hand out (*.trycloudflare.com and
# friends), so `npm run share` works without editing CORS_ORIGINS each restart.
# Defaults to on outside production. Turn OFF in production.
ALLOW_TUNNEL_ORIGINS=true

# --- Database -------------------------------------------------------
# Prisma reads DATABASE_URL natively. A password containing % : / ? # @ must be
# percent-encoded, or the URL parser will mangle it.
DATABASE_URL="mysql://root:your_password@localhost:3306/reusehub"

# --- Redis ----------------------------------------------------------
# Optional. With REDIS_ENABLED=false the cache is a pass-through and the API
# behaves identically, just without caching — set it to false when you have no
# Redis running locally to avoid connection warnings in the log.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
CACHE_TTL=60

# --- Authentication -------------------------------------------------
# No default on purpose: a shipped default secret is trivially forged. Generate
# one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- Rate limiting --------------------------------------------------
# Applied to /api/auth (brute force) and to writes. Requires Redis; with Redis
# off, limiting is skipped rather than failing closed.
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Seed admin -----------------------------------------------------
# Read only by `npm run db:seed`. Never by anything that serves a request.
# Left blank the seed skips admin creation — there is no default password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_MOBILE=
