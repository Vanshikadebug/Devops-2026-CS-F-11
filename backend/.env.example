# ===============================================================
# ReuseHub -- BACKEND environment template
# ===============================================================
#
# HOW TO USE THIS FILE
#   1. Copy it:  cp .env.example .env      (inside backend/)
#   2. Fill in the real values in .env
#   3. NEVER commit .env -- it is in .gitignore
#
# This .example file IS committed. It documents which variables
# the app needs, without revealing any actual secret. A teammate
# (or Jenkins) can clone the repo and immediately know what to set.
# ===============================================================

# --- Server ---------------------------------------------------
# 5000, NOT 8080: Jenkins already occupies 8080 on this machine.
PORT=5000
NODE_ENV=development

# --- MySQL connection -----------------------------------------
# DB_HOST is "localhost" when running with `npm run dev`.
# Under Docker Compose it becomes "mysql" (the service name),
# because containers reach each other by service name, not localhost.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_root_password
DB_NAME=reusehub

# --- Authentication -------------------------------------------
# JWT_SECRET signs every login token. Anyone who knows it can forge
# a token for ANY user. Use a long random string, never this text.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Password hashing -----------------------------------------
# bcrypt work factor. Higher = slower to hash = harder to brute
# force. 10 is a sane default; 12+ noticeably slows down tests.
BCRYPT_SALT_ROUNDS=10

# --- CORS -----------------------------------------------------
# Only this origin may call the API from a browser.
# Vite's dev server runs on 5173.
CLIENT_ORIGIN=http://localhost:5173
