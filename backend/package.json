{
  "name": "reusehub-backend",
  "version": "1.0.0",
  "description": "ReuseHub REST API - Node.js, Express, Prisma, MySQL, Redis",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "node scripts/prisma.js migrate deploy",
    "db:migrate:dev": "node scripts/prisma.js migrate dev",
    "db:generate": "node scripts/prisma.js generate",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node scripts/prisma.js migrate reset --force",
    "db:studio": "node scripts/prisma.js studio",
    "db:admin": "node scripts/create-admin.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "share": "node scripts/share.js",
    "share:stop": "docker compose --profile share stop tunnel"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "keywords": [
    "express",
    "prisma",
    "mysql",
    "redis",
    "rest-api",
    "jwt"
  ],
  "author": "ReuseHub",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "prisma": "^6.19.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
