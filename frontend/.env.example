# ReuseHub frontend — environment template
#
#   cp .env.example .env
#
# Everything here is optional. With no .env at all the app assumes the backend
# is on the same origin, which is what `npm run dev` from the repo root gives
# you (Vite proxies /api and /uploads to localhost:5000).

# --- Point at a backend running somewhere else -----------------------------
#
# Set this to work on the frontend WITHOUT running the backend, MySQL or Redis
# locally. Ask a teammate to run `npm run share` and paste the URL they give
# you here, then `npm run dev`.
#
# Include the scheme, no trailing slash, and no /api suffix:
#
#   VITE_API_URL=https://some-name.trycloudflare.com
#
# Whoever runs the backend must add your frontend origin to CORS_ORIGINS in
# their backend/.env, or the browser will block the requests.
#
# Vite inlines this at build time, so restart the dev server after changing it.
VITE_API_URL=
