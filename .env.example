# ===============================================================
# ReuseHub -- ROOT environment template (used by docker-compose)
# ===============================================================
#
# Copy to .env at the project root before running:
#   docker compose up --build
#
# docker-compose.yml reads these values to configure all three
# containers at once, so the MySQL container and the backend
# container agree on the same credentials.
# ===============================================================

# --- MySQL container ------------------------------------------
MYSQL_ROOT_PASSWORD=replace_with_a_strong_password
MYSQL_DATABASE=reusehub

# --- Backend container ----------------------------------------
# NOTE: DB_HOST is "mysql" here, not "localhost".
# Inside Docker's network, each container is reachable by its
# service name. "localhost" inside the backend container would
# mean the backend container itself -- there is no MySQL there.
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_NAME=reusehub

BACKEND_PORT=5000
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- Frontend container ---------------------------------------
FRONTEND_PORT=5173
