# ---- Docker Compose / API configuration -------------------------------
# Copy to .env and fill in. JWT_SECRET is the only required value.

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Database (compose creates this MySQL; DATABASE_URL is derived in compose)
DB_NAME=reusehub
DB_PASSWORD=reusehub

# Host port mappings. 3307 avoids a local MySQL on 3306;
# 3000 avoids Jenkins on 8080.
DB_PORT_HOST=3307
REDIS_PORT_HOST=6379
API_PORT=5000
WEB_PORT=3000

# Browser origin allowed by CORS.
CLIENT_ORIGIN=http://localhost:3000

# ---- Bootstrap admin -------------------------------------------------
# Used once by the seed to create the first super_admin. No defaults on
# purpose: a shipped default admin password is a documented backdoor.
# Leave blank to skip; create the account later with `npm run db:admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_MOBILE=
