# ---- Docker Compose / API configuration -------------------------------
# Copy to .env and fill in. JWT_SECRET is the only required value.

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# MongoDB (compose runs it as a single-node replica set; DATABASE_URL is
# derived in compose). The same login opens mongo-express' database view.
DB_NAME=reusehub
MONGO_USER=admin
MONGO_PASSWORD=password

# Login for the mongo-express web UI (http://localhost:8081) and Grafana.
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=reusehub
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Host port mappings.
# 3000 avoids Jenkins on 8080.
MONGO_PORT_HOST=27017
REDIS_PORT_HOST=6379
API_PORT=5000
WEB_PORT=3000

# Browser origin allowed by CORS.
CLIENT_ORIGIN=http://localhost:3000

# ---- Bootstrap admin -------------------------------------------------
# Used once by the seed to create the first super_admin. No defaults on
# purpose: a shipped default admin password is a documented backdoor.
# Leave blank to skip; create the account later with `npm run db:admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_MOBILE=
